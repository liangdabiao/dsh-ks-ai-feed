{
  "name": "dsh-ks-ai-feed",
  "version": "0.1.0",
  "description": "AI 快手日报 · 多关键词批量扫描快手 AI 创作内容：15 点日期规则、type/topic 六步智能聚类（泛标签过滤+标题关键词拆分+保底 5 分类）、AI 情报洞察（热度TOP话题/起量信号/核心达人/推荐调查方向/跨平台对比）、深色主题 HTML 日报。需 RedFox API Key，移植自 redfox-data/redfox-community skills/ks-ai-feed。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "lib",
    "lab",
    "skills",
    "assets",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "kuaishou",
    "ai-news",
    "daily-report",
    "intel",
    "feed"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "live": "node scripts/live.mjs",
    "dev": "node scripts/devserver.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
